<?xml version="1.0" encoding="utf-8"?>
<!--
  Hand-authored so it survives `dotnet publish`: when a web.config already exists in the
  project, the .NET SDK transforms it in place (filling in/checking processPath, arguments and
  hostingModel below) instead of generating a fresh one, so the <security> block added here is
  preserved across every publish. See "Deploy ASP.NET Core apps to IIS" in the ASP.NET Core docs
  for the transform's exact behavior.

  maxAllowedContentLength below matches ScanModel's [RequestSizeLimit(OuterCeilingBytes)] in
  Pages/Scan/Scan.cshtml.cs -- see that file's comment for the tiered-processing design behind
  this ceiling (uploads over 50 MB now process in the background -- Tier 2 in-process, Tier 3 via
  AuditTrailReview.IntegrationHub.WorkerService -- instead of being rejected outright). Capped at
  786,432,000 bytes / 750 MiB (down from an earlier 1,000,000,000-byte ceiling that was raised
  specifically to allow testing a real ~714 MB / 5,000,000-record file through Tier 3). Files over the outer
  ceiling are still expected to go through the FTP integration directly instead of this page.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\AuditTrailReview.WebApp.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <!-- 786,432,000 bytes: matches ScanModel's [RequestSizeLimit]. -->
          <requestLimits maxAllowedContentLength="786432000" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
