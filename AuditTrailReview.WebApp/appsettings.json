{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "DefaultConnection",
          "restrictedToMinimumLevel": "Warning",
          "sinkOptionsSection": {
            "tableName": "ApplicationLog",
            "schemaName": "dbo",
            "autoCreateSqlTable": false,
            "batchPostingLimit": 50,
            "batchPeriod": "0.00:00:05"
          },
          "columnOptionsSection": {
            "addStandardColumns": [],
            "timeStamp": {
              "convertToUtc": true
            },
            "additionalColumns": [
              {
                "ColumnName": "CorrelationId",
                "DataType": "nvarchar",
                "DataLength": 64,
                "AllowNull": true
              },
              {
                "ColumnName": "SourceContext",
                "DataType": "nvarchar",
                "DataLength": 256,
                "AllowNull": true
              },
              {
                "ColumnName": "Application",
                "DataType": "nvarchar",
                "DataLength": 128,
                "AllowNull": true
              }
            ]
          }
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "Application": "AuditTrailReview.WebApp"
    }
  },
  "AllowedHosts": "*",
  "SeedAccount": {
    "Email": "admin@yourcompany.com",
    "Password": "Choose-A-Strong-Password1!"
  },
  "ConnectionStrings": {
      "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=GxPAuditTrail;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "SmtpSettings": {
    "UserName": "",
    "Password": ""
  },
  "Security": {
    "EncryptionKey": "CHANGE_ME_32_BYTE_BASE64_KEY"
  }
}