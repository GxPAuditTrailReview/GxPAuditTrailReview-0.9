@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

@* This is where the cookie handler sends a signed-in user who lacks a required role (a 403). Same
   look as the shared Error page (Pages/Error.cshtml). *@
<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body text-center p-5">
                <i class="bi bi-shield-lock display-3 text-secondary" aria-hidden="true"></i>
                <h1 class="h3 mt-3">@ViewData["Title"]</h1>
                <p class="text-muted">
                    You don't have permission to open this page. If you think you should, ask an
                    administrator to check your role.
                </p>
                <p class="small text-muted">
                    Reference: <code>@HttpContext.TraceIdentifier</code>
                </p>
                <div class="d-flex gap-2 justify-content-center mt-4">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-area="" asp-page="/Dashboard/Index" class="btn btn-primary">
                            <i class="bi bi-house" aria-hidden="true"></i> Back to Dashboard
                        </a>
                    }
                    else
                    {
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary">
                            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Go to sign-in
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
