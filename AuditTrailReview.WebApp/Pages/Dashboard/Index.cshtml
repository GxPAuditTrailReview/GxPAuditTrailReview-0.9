@page
@model AuditTrailReview.WebApp.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<partial name="_Breadcrumb" model="@(new[] { new BreadcrumbItem("Dashboard") })" />
<hr />

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary shadow-sm">
            <div class="card-body text-center">
                <h5 class="card-title"><i class="bi bi-file-earmark-text"></i> Total scans</h5>
                <h2 class="display-4">@Model.TotalScans</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success shadow-sm">
            <div class="card-body text-center">
                <h5 class="card-title"><i class="bi bi-hourglass-split"></i> Scans to review</h5>
                <h2 class="display-4">@Model.ScansToReview</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info shadow-sm">
            <div class="card-body text-center">
                <h5 class="card-title"><i class="bi bi-hdd-network"></i> Systems</h5>
                <h2 class="display-4">@Model.TotalSystems</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning shadow-sm">
            <div class="card-body text-center">
                <h5 class="card-title"><i class="bi bi-exclamation-triangle"></i> Unreviewed findings</h5>
                <h2 class="display-4">@Model.UnreviewedFindings</h2>
            </div>
        </div>
    </div>
</div>

<!-- Latest Scans Table -->
<div class="mt-4">
    <h4><i class="bi bi-clock-history"></i> My Latest 5 scans</h4>
    <hr />
    @if (Model.LatestScans != null && Model.LatestScans.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover table-striped sortable">
                <thead class="table-primary">
                    <tr>
                        <th>Scan ID</th>
                        <th>System name</th>
                        <th>System ID</th>
                        <th>Scan date</th>
                        <th>File name</th>
                        <th>File type</th>
                        <th class="no-sort"></th> @*  to not sort the collumn *@
                    </tr>
                </thead>
                <tbody>
                    @foreach (var scan in Model.LatestScans)
                    {
                        <tr>
                            <td>@scan.Id</td>
                            <td>@(scan.System?.SystemName ?? "N/A")</td>
                            <td>@(scan.System?.SystemPrefixID ?? "N/A")</td>
                            <td>@if (scan.ScanDate is null) { @("N/A") } else { <utc-datetime value="scan.ScanDate" /> }</td>
                            <td>@scan.ATFileName</td>
                            <td>@scan.ATFileType</td>
                            <td>
                                <a asp-page="/Scan/Details" asp-route-id="@scan.Id" class="btn btn-warning nx-2"
                                   data-bs-toggle="tooltip" title="View details">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-3 d-flex gap-2">
            <a asp-page="/Scan/Index" class="btn btn-primary">
                <i class="bi bi-list"></i> View all scans
            </a>
            <a asp-page="/Scan/Preview" class="btn btn-warning">
                <i class="bi bi-eye"></i> Preview file
            </a>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No scans found. Start by scanning your first audit trail file.
        </div>
        <a asp-page="/System/Index" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add system & start scanning
        </a>
    }
</div>

<!-- Quick actions -->
<div class="mt-5">
    <h4><i class="bi bi-lightning"></i> Quick actions</h4>
    <hr />
    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-plus-circle display-4 text-primary"></i>
                    <h5 class="card-title mt-3">Add new system</h5>
                    <p class="card-text">Register a new system for audit trail review</p>
                    <a asp-page="/System/Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Add system
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-file-earmark-arrow-up display-4 text-success"></i>
                    <h5 class="card-title mt-3">Scan audit trail</h5>
                    <p class="card-text">Upload and analyze CSV audit trail files</p>
                    <a asp-page="/System/Index" class="btn btn-success">
                        <i class="bi bi-file-earmark-arrow-up"></i> Start scan
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-list-check display-4 text-info"></i>
                    <h5 class="card-title mt-3">View all scans</h5>
                    <p class="card-text">Browse and review all scan results</p>
                    <a asp-page="/Scan/Index" class="btn btn-info">
                        <i class="bi bi-list-check"></i> View scans
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var tooltipEls = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            tooltipEls.forEach(function (el) {
                new bootstrap.Tooltip(el);
            });
        });
    </script>
}

