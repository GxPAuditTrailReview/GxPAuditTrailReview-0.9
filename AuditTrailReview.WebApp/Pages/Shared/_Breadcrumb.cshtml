@model IEnumerable<BreadcrumbItem>
@{
    var items = Model.ToList();
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        @for (var i = 0; i < items.Count; i++)
        {
            var item = items[i];
            if (i == items.Count - 1)
            {
                <li class="breadcrumb-item active" aria-current="page">@item.Text</li>
            }
            else if (item.Page is not null)
            {
                <li class="breadcrumb-item"><a asp-page="@item.Page">@item.Text</a></li>
            }
            else
            {
                <li class="breadcrumb-item">@item.Text</li>
            }
        }
    </ol>
</nav>
