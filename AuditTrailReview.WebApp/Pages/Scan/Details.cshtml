                </div>
            </form>
        </div>
    </div>
</div>

@* Signing pop-ups for "Close review & sign" and "Reopen review". The signer re-enters their
   password; the login is prefilled with the signed-in account and read-only (the server also
   rejects any other value). See DetailsModel.ReauthenticateAsync. *@
@{
    var signOpenModal = TempData[DetailsModel.OpenSignModalKey] as string;
    var signError = TempData[DetailsModel.SignErrorKey] as string;
    var signDialogs = new List<(string Key, string ModalId, string Handler, string Title, string Text, string Submit, string SubmitClass, string Icon, string IconClass)>();
    if (!Model.Scan.ScanClosed)
    {
        signDialogs.Add((DetailsModel.SignModalClose, "signCloseModal", "SignAndClose",
            "Close review and sign",
            $"You are closing the review of Scan #{Model.Scan.Id} and signing it as \"Reviewed & Signed\". Enter your password to sign.",
            "Sign and close", "btn-dark", "bi-pen", "text-dark"));
    }
    if (Model.Scan.ScanClosed && (User.IsInRole("Admin") || User.IsInRole("Super User")))
    {
        signDialogs.Add((DetailsModel.SignModalReopen, "reopenModal", "Reopen",
            "Reopen review",
            $"You are reopening the signed review of Scan #{Model.Scan.Id}. This is recorded as a signature with reason \"Reopen review\". Enter your password to sign.",
            "Sign and reopen", "btn-warning", "bi-unlock", "text-warning"));
    }
}
@foreach (var dlg in signDialogs)
{
    <div class="modal fade" id="@dlg.ModalId" tabindex="-1" aria-labelledby="@(dlg.ModalId)Label" aria-hidden="true"
         data-sign-autoopen="@(signOpenModal == dlg.Key ? "true" : "false")">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="@dlg.Handler" asp-route-id="@Model.Scan.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ActiveTab" value="@Model.ActiveTab" class="sign-modal-active-tab" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="@(dlg.ModalId)Label">
                            <i class="bi @dlg.Icon @dlg.IconClass me-2" aria-hidden="true"></i>@dlg.Title
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="d-flex align-items-start gap-2 mb-3">
                            <i class="bi bi-file-earmark-check text-primary fs-4" aria-hidden="true"></i>
                            <p class="mb-0">@dlg.Text</p>
                        </div>
                        @if (signOpenModal == dlg.Key && !string.IsNullOrEmpty(signError))
                        {
                            <div class="alert alert-danger d-flex align-items-center gap-2 sign-error" role="alert">
                                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                <span>@signError</span>
                            </div>
                        }
                        <div class="mb-3">
                            <label for="@(dlg.ModalId)UserName" class="form-label fw-bold">Login</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person-badge" aria-hidden="true"></i></span>
                                <input type="text" id="@(dlg.ModalId)UserName" name="signUserName" class="form-control"
                                       value="@User.Identity?.Name" readonly autocomplete="username" />
                                <span class="input-group-text" title="Prefilled with your account; you can only sign as yourself">
                                    <i class="bi bi-lock-fill text-muted" aria-hidden="true"></i>
                                    <span class="visually-hidden">Read-only</span>
                                </span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="@(dlg.ModalId)Password" class="form-label fw-bold">Password</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key" aria-hidden="true"></i></span>
                                <input type="password" id="@(dlg.ModalId)Password" name="signPassword" class="form-control sign-password"
                                       required autocomplete="current-password" />
                            </div>
                        </div>
                        <div class="d-flex align-items-start gap-2 text-muted small">
                            <i class="bi bi-shield-lock" aria-hidden="true"></i>
                            <span>Your password is your electronic signature. Wrong passwords count toward account lockout, the same as failed logins.</span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-lg me-1" aria-hidden="true"></i>Cancel
                        </button>
                        <button type="submit" class="btn @dlg.SubmitClass">
                            <i class="bi @dlg.Icon me-1" aria-hidden="true"></i>@dlg.Submit
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}


@section Scripts {
    <script>
        // ── Copy a direct link to this scan (for sharing outside the app) ──
        // A plain absolute URL is enough: this page is [Authorize]-protected, so pasting it
        // while signed out already redirects to the login page with a ReturnUrl back to this
        // exact scan (standard ASP.NET Core Identity cookie-auth behavior -- see
        // Areas/Identity/Pages/Account/Login.cshtml.cs's OnPostAsync, and
        // TC-005-RedirectUnauthenticatedToLogin.md for the underlying mechanism, tested there
        // against /Dashboard but not specific to any one page), and a successful login lands
        // the user back here automatically. No custom redirect logic needed on this end.
        const copyLinkBtn = document.getElementById('copyScanLinkBtn');
        if (copyLinkBtn) {
            const defaultLabel = copyLinkBtn.innerHTML;
            let copyResetTimer = null;

            copyLinkBtn.addEventListener('click', async () => {
                const link = window.location.href;
                try {
                    // navigator.clipboard needs a secure context (HTTPS, or localhost) --
                    // undefined over plain HTTP, which some on-prem/internal deployments use.
                    if (!navigator.clipboard || !window.isSecureContext) {
                        throw new Error('Clipboard API unavailable in this context');
                    }
                    await navigator.clipboard.writeText(link);
                    copyLinkBtn.innerHTML = '✅ Copied!';
                } catch {
                    // Fall back to a manual copy so the feature still works over plain HTTP or
                    // if the clipboard permission is denied.
                    window.prompt('Copy this link:', link);
                    copyLinkBtn.innerHTML = '🔗 Copy link';
                }

                clearTimeout(copyResetTimer);
                copyResetTimer = setTimeout(() => { copyLinkBtn.innerHTML = defaultLabel; }, 1500);
            });
        }

        // ── Keep the Review/Assign System modals' hidden ActiveTab input in sync with whichever
        // tab is CURRENTLY visible client-side ──
        // Which Bootstrap tab is showing is itself client-side state that doesn't reload the
        // page, so Model.ActiveTab (server-rendered at the top of this GET) can be stale by the
        // time the reviewer opens a modal from a different tab than the one active on load.
        // Submitting a Review/Assign from within, say, the Potential findings tab should return
        // the reviewer to that tab after the redirect -- not whichever tab was active initially.
        document.querySelectorAll('#scanTabs button[data-bs-toggle="tab"]').forEach(tabButton => {
            tabButton.addEventListener('shown.bs.tab', () => {
                const tabId = tabButton.dataset.bsTarget?.replace('#', '') ?? '';
                const reviewInput = document.getElementById('reviewModalActiveTab');
                const assignInput = document.getElementById('assignSystemModalActiveTab');
                if (reviewInput) reviewInput.value = tabId;
                if (assignInput) assignInput.value = tabId;
                document.querySelectorAll('.sign-modal-active-tab').forEach(i => { i.value = tabId; });
            });
        });

        // ── Signing pop-ups (Close review & sign / Reopen review) ──
        // Focus the password on open, and re-open the pop-up after a failed re-authentication
        // (the handler sets TempData OpenSignModal, rendered as data-sign-autoopen) so the user
        // sees the error where they typed the password.
        document.querySelectorAll('#signCloseModal, #reopenModal').forEach(modalEl => {
            modalEl.addEventListener('shown.bs.modal', () => {
                modalEl.querySelector('.sign-password')?.focus();
            });
            modalEl.addEventListener('hidden.bs.modal', () => {
                const pwd = modalEl.querySelector('.sign-password');
                if (pwd) pwd.value = '';
                modalEl.querySelector('.sign-error')?.remove();
            });
            if (modalEl.dataset.signAutoopen === 'true') {
                new bootstrap.Modal(modalEl).show();
            }
        });

        // ── Preserve scroll position across full-page reloads ──
        // Every interaction on this page that changes anything -- "Save review", "Assign",
        // paging either grid, or searching either grid -- is now a plain full-page GET/POST
        // navigation (asp-page links, a <form method="get">, or a modal's <form method="post">),
        // not an AJAX call, since Sept 2026's switch to the same server-rendered pagination
        // Scan/Index uses. The browser resets scroll to the top of the fresh page by default on
        // every one of those, which is jarring here: paging or reviewing findings one row at a
        // time in a long results table meant losing your place back to the top after every single
        // click (user-reported, Scan/Details?id=10022 and again after the pagination rewrite).
        // Rather than wiring a stash-before-navigate listener onto every individual link/form
        // (pagination links in both tabs, both search forms, both modal forms -- easy to miss one
        // as the page evolves), 'beforeunload' fires for ALL of them uniformly, plus browser
        // back/forward and a manual refresh. sessionStorage survives a full navigation within the
        // same tab (and is scoped per-tab, so two scans open in different tabs never collide);
        // keying by scan ID keeps a stash made here from ever being misapplied if the reviewer
        // instead navigates away to a different page/scan and back.
        const SCROLL_RESTORE_KEY = `scanDetailsScrollY_@(Model.Scan.Id)`;

        window.addEventListener('beforeunload', () => {
            sessionStorage.setItem(SCROLL_RESTORE_KEY, String(window.scrollY));
        });

        const savedScrollY = sessionStorage.getItem(SCROLL_RESTORE_KEY);
        if (savedScrollY !== null) {
            sessionStorage.removeItem(SCROLL_RESTORE_KEY);
            // Wait a frame so the browser has finished its own initial layout/scroll-to-top
            // first -- restoring immediately can otherwise get clobbered by that default.
            requestAnimationFrame(() => window.scrollTo(0, parseInt(savedScrollY, 10)));
        }

        const reviewModal = document.getElementById('reviewModal');
        reviewModal.addEventListener('show.bs.modal', event => {
            const btn = event.relatedTarget;

            document.getElementById('modalScanResultId').value = btn.dataset.id;
            document.getElementById('modalFindingText').textContent = btn.dataset.finding;
            document.getElementById('ReviewComment').value = btn.dataset.comment ?? '';

            // Pre-select the current status radio button
            const currentStatus = parseInt(btn.dataset.status, 10);
            document.querySelectorAll('input[name="ReviewStatus"]').forEach(r => {
                r.checked = parseInt(r.value, 10) === currentStatus;
            });
        });

        // ── Bulk review: rule summary + confirmation pop-up (see DetailsModel's "Bulk review"
        // section). All text from the server is set via textContent, never innerHTML. ──
        (function bulkReview() {
            const card = document.getElementById('bulkReviewCard');
            const modalEl = document.getElementById('bulkReviewModal');
            if (!card || !modalEl) return; // scan closed

            const body = document.getElementById('bulkSummaryBody');
            const totalEl = document.getElementById('bulkSummaryTotal');
            let summaryLoaded = false;

            function el(tag, className, text) {
                const e = document.createElement(tag);
                if (className) e.className = className;
                if (text !== undefined) e.textContent = text;
                return e;
            }

            async function loadSummary() {
                if (summaryLoaded) return;
                summaryLoaded = true;
                try {
                    const res = await fetch(card.dataset.summaryUrl, { headers: { 'Accept': 'application/json' } });
                    if (!res.ok) throw new Error(res.status);
                    const data = await res.json();
                    body.replaceChildren();
                    totalEl.textContent = `${data.unreviewed.toLocaleString()} unreviewed finding${data.unreviewed === 1 ? '' : 's'}`;
                    const badge = document.getElementById('bulkUnreviewedBadge');
                    if (badge) badge.textContent = String(data.unreviewed);
                    if (data.items.length === 0) {
                        body.appendChild(el('p', 'text-muted small m-3', data.unreviewed === 0
                            ? 'All findings in this scan have been reviewed.'
                            : 'No unreviewed findings carry a known rule code. Use a search to review them in bulk.'));
                        return;
                    }
                    const wrap = el('div', 'table-responsive');
                    const table = el('table', 'table table-sm table-hover align-middle mb-0');
                    const thead = el('thead', 'table-light');
                    const hr = el('tr');
                    ['Rule', 'Description', 'Unreviewed', 'Only finding on row', ''].forEach((h, i) => {
                        const th = el('th', i >= 2 && i <= 3 ? 'text-end' : '', h);
                        hr.appendChild(th);
                    });
                    thead.appendChild(hr);
                    table.appendChild(thead);
                    const tbody = el('tbody');
                    data.items.forEach(item => {
                        const tr = el('tr');
                        const codeTd = el('td');
                        codeTd.appendChild(el('span', 'badge bg-secondary', item.ruleCode));
                        tr.appendChild(codeTd);
                        tr.appendChild(el('td', 'small', item.description ?? ''));
                        tr.appendChild(el('td', 'text-end', item.unreviewed.toLocaleString()));
                        tr.appendChild(el('td', 'text-end', item.soleFinding.toLocaleString()));
                        const actionTd = el('td', 'text-end');
                        const btn = el('button', 'btn btn-sm btn-outline-primary', 'Review all…');
                        btn.type = 'button';
                        btn.dataset.bsToggle = 'modal';
                        btn.dataset.bsTarget = '#bulkReviewModal';
                        btn.dataset.bulkScope = '@DetailsModel.BulkScopeRule';
                        btn.dataset.bulkRule = item.ruleCode;
                        btn.dataset.bulkLabel = `Unreviewed findings with rule ${item.ruleCode}: ${item.description ?? ''}`;
                        actionTd.appendChild(btn);
                        tr.appendChild(actionTd);
                        tbody.appendChild(tr);
                    });
                    table.appendChild(tbody);
                    wrap.appendChild(table);
                    body.appendChild(wrap);
                } catch {
                    summaryLoaded = false;
                    body.replaceChildren(el('p', 'text-danger small m-3', 'Could not load the rule summary. Reload the page to try again.'));
                }
            }

            // Load the summary the first time the Bulk review sub-tab becomes visible: either it
            // is opened, or the top-level Potential findings tab is opened while it's selected.
            const topTab = document.getElementById('potential-findings-tab');
            const bulkSubTab = document.getElementById('findings-bulk-tab');
            const listSubTab = document.getElementById('findings-list-tab');
            const bulkVisible = () => topTab?.classList.contains('active') && bulkSubTab?.classList.contains('active');
            bulkSubTab?.addEventListener('shown.bs.tab', loadSummary);
            topTab?.addEventListener('shown.bs.tab', () => { if (bulkVisible()) loadSummary(); });
            if (bulkVisible()) loadSummary();

            // "Open Bulk review" hint in the list, and "check them in the list" link in the bulk sub-tab.
            document.getElementById('goToBulkReview')?.addEventListener('click', () => {
                bootstrap.Tab.getOrCreateInstance(bulkSubTab).show();
            });
            document.getElementById('bulkShowMatches')?.addEventListener('click', e => {
                e.preventDefault();
                bootstrap.Tab.getOrCreateInstance(listSubTab).show();
            });

            // ── Pop-up ──
            const scopeInput = document.getElementById('bulkScope');
            const ruleInput = document.getElementById('bulkRuleCode');
            const searchInput = document.getElementById('bulkSearchTerm');
            const expectedInput = document.getElementById('bulkExpectedCount');
            const soleWrapper = document.getElementById('bulkSoleWrapper');
            const soleCheckbox = document.getElementById('bulkOnlySole');
            const preview = document.getElementById('bulkPreview');
            const comment = document.getElementById('bulkComment');
            const confirm = document.getElementById('bulkConfirm');
            const confirmLabel = document.getElementById('bulkConfirmLabel');
            const submit = document.getElementById('bulkSubmit');
            let previewCount = 0;
            let previewOk = false;
            let previewSeq = 0;

            function updateSubmit() {
                const statusChosen = !!modalEl.querySelector('.bulk-status:checked');
                submit.disabled = !(previewOk && statusChosen && comment.value.trim().length > 0 && confirm.checked);
                submit.textContent = previewOk ? `Apply to ${previewCount.toLocaleString()} finding${previewCount === 1 ? '' : 's'}` : 'Apply to findings';
            }

            async function runPreview() {
                const seq = ++previewSeq;
                previewOk = false;
                confirm.checked = false;
                preview.className = 'alert alert-secondary py-2';
                preview.textContent = 'Counting matching findings…';
                updateSubmit();

                const params = new URLSearchParams({ scope: scopeInput.value });
                if (scopeInput.value === '@DetailsModel.BulkScopeRule') {
                    params.set('ruleCode', ruleInput.value);
                    params.set('onlySoleFinding', soleCheckbox.checked ? 'true' : 'false');
                } else {
                    params.set('searchTerm', searchInput.value);
                }
                const sep = card.dataset.previewUrl.includes('?') ? '&' : '?';
                try {
                    const res = await fetch(card.dataset.previewUrl + sep + params.toString(), { headers: { 'Accept': 'application/json' } });
                    if (!res.ok) throw new Error(res.status);
                    const data = await res.json();
                    if (seq !== previewSeq) return; // a newer preview superseded this one

                    if (data.error) {
                        preview.className = 'alert alert-danger py-2';
                        preview.textContent = data.error;
                    } else if (data.overLimit) {
                        preview.className = 'alert alert-danger py-2';
                        preview.textContent = `${data.count.toLocaleString()} findings match, more than the ${data.maxRows.toLocaleString()} a single bulk review can change. Narrow the selection with a search term.`;
                    } else if (data.count === 0) {
                        preview.className = 'alert alert-warning py-2';
                        preview.textContent = 'No unreviewed findings match this selection.';
                    } else {
                        previewCount = data.count;
                        previewOk = true;
                        expectedInput.value = String(data.count);
                        preview.className = 'alert alert-info py-2';
                        let text = `This will set ${data.count.toLocaleString()} unreviewed finding${data.count === 1 ? '' : 's'} to the decision below. Findings that already have a review are not changed.`;
                        if (data.excluded > 0) {
                            text += ` ${data.excluded.toLocaleString()} more row${data.excluded === 1 ? '' : 's'} with this rule also ${data.excluded === 1 ? 'has' : 'have'} other findings and ${data.excluded === 1 ? 'is' : 'are'} not included.`;
                        }
                        preview.textContent = text;
                        confirmLabel.textContent = `I have checked these ${data.count.toLocaleString()} findings, and the decision and comment apply to every one of them.`;
                    }
                } catch {
                    if (seq !== previewSeq) return;
                    preview.className = 'alert alert-danger py-2';
                    preview.textContent = 'Could not count the matching findings. Close this pop-up and try again.';
                }
                updateSubmit();
            }

            modalEl.addEventListener('show.bs.modal', event => {
                const btn = event.relatedTarget;
                if (!btn) return;
                scopeInput.value = btn.dataset.bulkScope ?? '';
                ruleInput.value = btn.dataset.bulkRule ?? '';
                searchInput.value = btn.dataset.bulkSearch ?? '';
                document.getElementById('bulkSelectionLabel').textContent = btn.dataset.bulkLabel ?? '';
                soleWrapper.hidden = scopeInput.value !== '@DetailsModel.BulkScopeRule';
                soleCheckbox.checked = true;
                modalEl.querySelectorAll('.bulk-status').forEach(r => { r.checked = false; });
                comment.value = '';
                expectedInput.value = '0';
                confirmLabel.textContent = 'I have checked the findings in this selection, and the decision and comment apply to every one of them.';
                runPreview();
            });

            soleCheckbox.addEventListener('change', runPreview);
            comment.addEventListener('input', updateSubmit);
            confirm.addEventListener('change', updateSubmit);
            modalEl.querySelectorAll('.bulk-status').forEach(r => r.addEventListener('change', updateSubmit));
            document.getElementById('bulkReviewForm').addEventListener('submit', () => { submit.disabled = true; });
        })();

        // ── AI Analysis tab: poll for a background result and update in place ──
        // (see ADR-0006 / NFR-014 -- the AI call runs asynchronously after upload, so this
        // tab has nothing to show yet on the first page load for a scan whose AI job hasn't
        // finished. Rather than making the reviewer keep refreshing the page, poll quietly
        // and swap the content in when it's ready.)
        (function pollAiAnalysis() {
            const pane = document.getElementById('ai-analysis');
            const pendingEl = document.getElementById('ai-analysis-pending');
            if (!pane || !pendingEl) return; // already has results, or never will -- nothing to poll for

            const pollUrl = pane.dataset.aiPollUrl;
            const pollIntervalMs = 5000;
            const maxPollMs = 10 * 60 * 1000; // matches DetailsModel.AiAnalysisPendingWindow
            const startedAt = Date.now();

            function escapeHtml(str) {
                const div = document.createElement('div');
                div.textContent = str ?? '';
                return div.innerHTML;
            }

            function renderResults(items) {
                const contentEl = document.getElementById('ai-analysis-content');
                const badgeEl = document.getElementById('ai-analysis-badge');
                if (!contentEl) return;

                const rows = items.map(item => `
                    <tr>
                        <td>${escapeHtml(item.insight)}</td>
                        <td>${escapeHtml(item.recommendation)}</td>
                    </tr>`).join('');

                contentEl.innerHTML = `
                    <div class="table-responsive"><table class="table table-bordered table-hover table-striped mt-2">
                        <thead class="table-success">
                            <tr><th>Insight</th><th>Recommendation</th></tr>
                        </thead>
                        <tbody>${rows}</tbody>
                    </table></div>`;

                if (badgeEl) badgeEl.textContent = items.length;
            }

            function showGaveUp() {
                pendingEl.innerHTML = `
                    <p class="text-muted mt-2">
                        AI analysis is taking longer than expected. It may still complete in the
                        background -- refresh this page later to check.
                    </p>`;
            }

            function poll() {
                if (Date.now() - startedAt > maxPollMs) {
                    showGaveUp();
                    return;
                }

                fetch(pollUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(r => r.ok ? r.json() : Promise.reject(r.status))
                    .then(data => {
                        if (data && data.ready) {
                            renderResults(data.items || []);
                        } else {
                            setTimeout(poll, pollIntervalMs);
                        }
                    })
                    .catch(() => setTimeout(poll, pollIntervalMs));
            }

            setTimeout(poll, pollIntervalMs);
        })();
    </script>
}

@{
    // Shared by both the Scan results and Potential findings tabs above (@foreach (var item in
    // Model.ScanResults / Model.PotentialFindings) { await RenderScanResultRowAsync(item); }) so
    // the two tabs render rows identically and can never drift apart from each other -- async
    // because it renders a <utc-datetime> TagHelper (MVC1006). GetRowClass and
    // ShouldShowLiveUsernameTooShortFinding live on DetailsModel (Details.cshtml.cs) rather than
    // only here, since OnGetAsync's HasAnyFindingExpr query needs the same "does this row have a
    // finding" logic to be usable from a LINQ expression too.
    async Task RenderScanResultRowAsync(ScanResultInfo item)
    {
        var usernameTooShort = !string.IsNullOrEmpty(item.UserID)
                               && item.UserID.Length < Model.Settings.UsernameMinLength;
        var showLiveD2 = AuditTrailReview.WebApp.Pages.Scan.DetailsModel.ShouldShowLiveUsernameTooShortFinding(item.Finding, usernameTooShort);
        var rowClass = AuditTrailReview.WebApp.Pages.Scan.DetailsModel.GetRowClass(item, usernameTooShort);

        string? badgeClass = null, icon = null, label = null;
        if (item.ReviewStatus.HasValue)
        {
            (badgeClass, icon, label) = item.ReviewStatus switch
            {
                FindingReviewStatus.FalsePositive         => ("bg-success", "✔", "False positive"),
                FindingReviewStatus.InvestigationRequired => ("bg-warning text-dark", "⚠", "Investigation required"),
                FindingReviewStatus.Deviation              => ("bg-danger", "❌", "Deviation"),
                _                                          => ("bg-secondary", "", "")
            };
        }

        <tr class="@rowClass">
            <td>@item.UniqueIdentifier</td>
            <td><utc-datetime value="item.Timestamp" /></td>
            <td>@item.UserID</td>
            <td>@item.ObjectType</td>
            <td>@item.Object</td>
            <td>@item.Field</td>
            <td>@item.Operation</td>
            <td>@item.OldValue</td>
            <td>@item.NewValue</td>
            <td>@item.Reason</td>
            <td>@item.Source</td>
            <td>
                @item.Finding
                @if (showLiveD2)
                {
                    <br />
                    <text>[D2] Username is too short — value: '@item.UserID' (@(item.UserID!.Length) character(s), minimum @Model.Settings.UsernameMinLength required)</text>
                }
            </td>
            <td>
                @if (item.ReviewStatus.HasValue)
                {
                    <span class="badge @badgeClass" title="@item.ReviewComment">
                        @icon @label
                    </span>
                    @if (!string.IsNullOrWhiteSpace(item.ReviewedBy))
                    {
                        <div class="text-muted small mt-1">by @item.ReviewedBy on <utc-datetime value="item.ReviewedAt" /></div>
                    }
                }
            </td>
            @if (!Model.Scan.ScanClosed)
            {
                <td>
                    @if (!string.IsNullOrWhiteSpace(item.Finding))
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                data-bs-toggle="modal" data-bs-target="#reviewModal"
                                data-id="@item.Id"
                                data-finding="@item.Finding"
                                data-status="@(item.ReviewStatus.HasValue ? ((int)item.ReviewStatus.Value).ToString() : "")"
                                data-comment="@item.ReviewComment">
                            Review
                        </button>
                    }
                </td>
            }
        </tr>
    }
}
