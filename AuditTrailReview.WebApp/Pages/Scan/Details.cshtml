@page
@model AuditTrailReview.WebApp.Pages.Scan.DetailsModel
@using AuditTrailReview.Model

@{
    ViewData["Title"] = $"Scan #{Model.Scan.Id}";
}

<partial name="_Breadcrumb" model="@(new[] { new BreadcrumbItem("Scans", "/Scan/Index"), new BreadcrumbItem($"Scan #{Model.Scan.Id}") })" />
<hr />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData[DetailsModel.MessageKey] != null)
{
    <div class="alert alert-success">@TempData[DetailsModel.MessageKey]</div>
}

<div class="mb-3 d-flex gap-2">
    <a asp-page-handler="ExportExcel" asp-route-id="@Model.Scan.Id"
       class="btn btn-success">
        📥 Export to Excel
    </a>
    @* Both buttons open a signing pop-up that asks for the password again (21 CFR 11.200(a));
       see DetailsModel.ReauthenticateAsync. *@
    @if (!Model.Scan.ScanClosed)
    {
        <span title="@(Model.HasUnreviewedFindings ? "All findings must be reviewed before closing." : "")"
              style="@(Model.HasUnreviewedFindings ? "cursor: not-allowed; display: inline-block;" : "")">
            <button type="button" class="btn btn-dark" id="signCloseBtn"
                    data-bs-toggle="modal" data-bs-target="#signCloseModal"
                    @(Model.HasUnreviewedFindings ? "disabled style=\"pointer-events: none;\"" : "")>
                ✍️ Close review &amp; sign
            </button>
        </span>
    }
    @if (Model.Scan.ScanClosed && (User.IsInRole("Admin") || User.IsInRole("Super User")))
    {
        <button type="button" class="btn btn-warning" id="reopenBtn"
                data-bs-toggle="modal" data-bs-target="#reopenModal">
            🔓 Reopen review
        </button>
    }
    @if (Model.Scan.SystemID == 0 && (User.IsInRole("Admin") || User.IsInRole("Super User")))
    {
        <button type="button" class="btn btn-outline-primary"
                data-bs-toggle="modal" data-bs-target="#assignSystemModal">
            🔗 Assign system
        </button>
    }
    <button type="button" id="copyScanLinkBtn" class="btn btn-outline-secondary"
            title="Copy a direct link to this scan -- pasting it while signed out goes to the login page first, then straight here">
        🔗 Copy link
    </button>
</div>


<div>
    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                @if (Model.Scan.SystemID != 0)
                {
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Scan.System!.SystemPrefixID)
                    </dt>
                    <dd class="col-sm-8">
                        <a asp-page="/System/Details" asp-route-id="@Model.Scan.SystemID"
                           title="Open this system's details page">
                            @Html.DisplayFor(model => model.Scan.System!.SystemPrefixID)
                        </a>
                    </dd>
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Scan.System!.SystemName)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Scan.System!.SystemName)
                    </dd>
                }
               else
               {
                   <dt class="col-sm-4">System</dt>
                   <dd class="col-sm-8">
                       <span class="text-muted fst-italic">Not assigned</span>
                   </dd>
               }
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Scan.ScanDate)
                </dt>
                <dd class="col-sm-8">
                    <utc-datetime value="Model.Scan.ScanDate" />
                </dd>
            </dl>
        </div>
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">
                    Status
                </dt>
                <dd class="col-sm-8">
                    @if (Model.Scan.ScanClosed)
                    {
                        <span class="badge bg-success fs-6">✅ Reviewed &amp; signed</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark fs-6">🔍 Under review</span>
                    }
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Scan.ATFileName)
                </dt>
                <dd class="col-sm-8">
                    @if (Model.HasOriginalFile)
                    {
                        <a asp-page-handler="DownloadFile" asp-route-id="@Model.Scan.Id">@Html.DisplayFor(model => model.Scan.ATFileName)</a>
                    }
                    else
                    {
                        @Html.DisplayFor(model => model.Scan.ATFileName)
                        <span class="text-muted small">(original file not available)</span>
                    }
                </dd>
                <dt class="col-sm-4">
                    Scanned by
                </dt>
                <dd class="col-sm-8">
                    @if (Model.Scan.UserId is null)
                    {
                        <span class="text-muted fst-italic">Not applicable (ingested via FTP/API)</span>
                    }
                    else
                    {
                        @Model.UploadedByDisplayName
                    }
                </dd>
            </dl>
        </div>
    </div>
</div>

<div class="mt-4">
    <!-- Tab navigation -->
    <ul class="nav nav-tabs" id="scanTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "scan-results" ? "active" : "")" id="scan-results-tab"
                    data-bs-toggle="tab" data-bs-target="#scan-results"
                    type="button" role="tab"
                    aria-controls="scan-results" aria-selected="@(Model.ActiveTab == "scan-results" ? "true" : "false")">
                Scan results
                <span class="badge bg-primary ms-1">@Model.ScanResultsTotalCount</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "potential-findings" ? "active" : "")" id="potential-findings-tab"
                    data-bs-toggle="tab" data-bs-target="#potential-findings"
                    type="button" role="tab"
                    aria-controls="potential-findings" aria-selected="@(Model.ActiveTab == "potential-findings" ? "true" : "false")">
                ⚠ Potential findings
                <span class="badge bg-danger ms-1">@Model.PotentialFindingsTotalCount</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "ai-analysis" ? "active" : "")" id="ai-analysis-tab"
                    data-bs-toggle="tab" data-bs-target="#ai-analysis"
                    type="button" role="tab"
                    aria-controls="ai-analysis" aria-selected="@(Model.ActiveTab == "ai-analysis" ? "true" : "false")">
                AI analysis
                @if (Model.ScanResultsAI != null)
                {
                    <span id="ai-analysis-badge" class="badge bg-success ms-1">@Model.ScanResultsAI.Count</span>
                }
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "signatures" ? "active" : "")" id="signatures-tab"
                    data-bs-toggle="tab" data-bs-target="#signatures"
                    type="button" role="tab"
                    aria-controls="signatures" aria-selected="@(Model.ActiveTab == "signatures" ? "true" : "false")">
                ✅ Reviewed &amp; signed
                @if (Model.ScanSignatures.Any())
                {
                    <span class="badge bg-dark ms-1">@Model.ScanSignatures.Count</span>
                }
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "audit-trail" ? "active" : "")" id="audit-trail-tab"
                    data-bs-toggle="tab" data-bs-target="#audit-trail"
                    type="button" role="tab"
                    aria-controls="audit-trail" aria-selected="@(Model.ActiveTab == "audit-trail" ? "true" : "false")">
                📜 Audit trail
            </button>
        </li>
    </ul>

    <!-- Tab content -->
    <div class="tab-content border border-top-0 rounded-bottom p-3" id="scanTabsContent">

        <!-- Scan results tab -->
        <div class="tab-pane fade @(Model.ActiveTab == "scan-results" ? "show active" : "")" id="scan-results"
             role="tabpanel" aria-labelledby="scan-results-tab">

            <form method="get" asp-page="./Details" class="row g-2 align-items-center mb-3">
                <input type="hidden" name="id" value="@Model.Scan.Id" />
                <input type="hidden" name="ActiveTab" value="scan-results" />
                <input type="hidden" name="PotentialFindingsPage" value="@Model.PotentialFindingsPage" />
                <input type="hidden" name="PotentialFindingsSearchTerm" value="@Model.PotentialFindingsSearchTerm" />
                <input type="hidden" name="AuditTrailPage" value="@Model.AuditTrailPage" />
                <input type="hidden" name="AuditTrailSearchTerm" value="@Model.AuditTrailSearchTerm" />
                <div class="col-sm-4 col-lg-3">
                    <input type="text" name="ScanResultsSearchTerm" value="@Model.ScanResultsSearchTerm" class="form-control"
                           placeholder="Search scan results..." />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.ScanResultsSearchTerm))
                {
                    <div class="col-auto">
                        <a asp-page="./Details" asp-route-id="@Model.Scan.Id" asp-route-ActiveTab="scan-results"
                           asp-route-PotentialFindingsPage="@Model.PotentialFindingsPage"
                           asp-route-PotentialFindingsSearchTerm="@Model.PotentialFindingsSearchTerm"
                           asp-route-AuditTrailPage="@Model.AuditTrailPage"
                           asp-route-AuditTrailSearchTerm="@Model.AuditTrailSearchTerm"
                           class="btn btn-outline-secondary">Clear</a>
                    </div>
                }
            </form>

            @if (Model.ScanResults != null && Model.ScanResults.Any())
            {
                <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped sortable mt-2">
                    <thead class="table-primary">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.ScanResults[0].UniqueIdentifier)</th>
                            <th>@Html.DisplayNameFor(model => model.ScanResults[0].Timestamp)</th>
                            <th>@Html.DisplayNameFor(model => model.ScanResults[0].UserID)</th>
                            <th>@Html.DisplayNameFor(model => model.ScanResults[0].ObjectType)</th>
                            <th>@Html.DisplayNameFor(model => model.ScanResults[0].Object)</th>
                            <th>@Html.DisplayNameFor(model => model.ScanResults[0].Field)</th>
                            <th>@Html.DisplayNameFor(model => model.ScanResults[0].Operation)</th>
                            <th>@Html.DisplayNameFor(model => model.ScanResults[0].OldValue)</th>
                            <th>@Html.DisplayNameFor(model => model.ScanResults[0].NewValue)</th>
                            <th>@Html.DisplayNameFor(model => model.ScanResults[0].Reason)</th>
                            <th>@Html.DisplayNameFor(model => model.ScanResults[0].Source)</th>
                            <th>@Html.DisplayNameFor(model => model.ScanResults[0].Finding)</th>
                            <th class="no-sort">@Html.DisplayNameFor(model => model.ScanResults[0].ReviewStatus)</th>
                            @if (!Model.Scan.ScanClosed)
                            {
                                <th class="no-sort"></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
@foreach (var item in Model.ScanResults) { await RenderScanResultRowAsync(item); }
                    </tbody>
                </table>
                </div>

                @if (Model.ScanResultsTotalPages > 1)
                {
                    <nav aria-label="Scan results pages">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.ScanResultsPage <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-page="./Details" asp-route-id="@Model.Scan.Id"
                                   asp-route-ScanResultsPage="@(Model.ScanResultsPage - 1)" asp-route-ScanResultsSearchTerm="@Model.ScanResultsSearchTerm"
                                   asp-route-PotentialFindingsPage="@Model.PotentialFindingsPage" asp-route-PotentialFindingsSearchTerm="@Model.PotentialFindingsSearchTerm"
                                   asp-route-AuditTrailPage="@Model.AuditTrailPage" asp-route-AuditTrailSearchTerm="@Model.AuditTrailSearchTerm"
                                   asp-route-ActiveTab="scan-results"
                                   aria-label="Previous" tabindex="@(Model.ScanResultsPage <= 1 ? "-1" : null)">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            @foreach (var p in Model.ScanResultsPageNumbers)
                            {
                                if (p is null)
                                {
                                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                }
                                else
                                {
                                    <li class="page-item @(p == Model.ScanResultsPage ? "active" : "")">
                                        <a class="page-link" asp-page="./Details" asp-route-id="@Model.Scan.Id"
                                           asp-route-ScanResultsPage="@p" asp-route-ScanResultsSearchTerm="@Model.ScanResultsSearchTerm"
                                           asp-route-PotentialFindingsPage="@Model.PotentialFindingsPage" asp-route-PotentialFindingsSearchTerm="@Model.PotentialFindingsSearchTerm"
                                           asp-route-AuditTrailPage="@Model.AuditTrailPage" asp-route-AuditTrailSearchTerm="@Model.AuditTrailSearchTerm"
                                           asp-route-ActiveTab="scan-results">@p</a>
                                    </li>
                                }
                            }
                            <li class="page-item @(Model.ScanResultsPage >= Model.ScanResultsTotalPages ? "disabled" : "")">
                                <a class="page-link" asp-page="./Details" asp-route-id="@Model.Scan.Id"
                                   asp-route-ScanResultsPage="@(Model.ScanResultsPage + 1)" asp-route-ScanResultsSearchTerm="@Model.ScanResultsSearchTerm"
                                   asp-route-PotentialFindingsPage="@Model.PotentialFindingsPage" asp-route-PotentialFindingsSearchTerm="@Model.PotentialFindingsSearchTerm"
                                   asp-route-AuditTrailPage="@Model.AuditTrailPage" asp-route-AuditTrailSearchTerm="@Model.AuditTrailSearchTerm"
                                   asp-route-ActiveTab="scan-results"
                                   aria-label="Next" tabindex="@(Model.ScanResultsPage >= Model.ScanResultsTotalPages ? "-1" : null)">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                    <p class="text-center text-muted small">
                        Page @Model.ScanResultsPage of @Model.ScanResultsTotalPages
                        (@Model.ScanResultsTotalCount total result@(Model.ScanResultsTotalCount == 1 ? "" : "s")@(string.IsNullOrWhiteSpace(Model.ScanResultsSearchTerm) ? "" : $" matching \"{Model.ScanResultsSearchTerm}\"")).
                    </p>
                }
            }
            else
            {
                <p class="text-muted mt-2">
                    @(string.IsNullOrWhiteSpace(Model.ScanResultsSearchTerm) ? "No scan results found for this scan." : $"No scan results match \"{Model.ScanResultsSearchTerm}\".")
                </p>
            }
        </div>

        <!-- Potential findings tab: restricted up front to the rows DetailsModel.HasAnyFindingExpr
             keeps (a persisted Finding from the engine, or a live dynamic violation like the D2
             short-username re-check) -- see OnGetAsync's PotentialFindings query. -->
        <div class="tab-pane fade @(Model.ActiveTab == "potential-findings" ? "show active" : "")" id="potential-findings"
             role="tabpanel" aria-labelledby="potential-findings-tab">

            @* Two sub-tabs: the findings list itself, and Bulk review (rule summary + review by
               search). Only the list is shown once the scan is closed, since nothing can be
               reviewed then. Which sub-tab is open is Model.FindingsView, kept across the bulk
               sub-tab's own search and after a bulk review (see OnPostBulkReviewAsync). *@
            @{
                var canBulkReview = !Model.Scan.ScanClosed;
                var showBulk = canBulkReview && Model.FindingsView == DetailsModel.FindingsViewBulk;
            }
            @if (canBulkReview)
            {
                @* Underline style (Bootstrap 5.3 nav-underline), smaller than the main tabs, so it
                   reads as a second level under "Potential findings". *@
                <ul class="nav nav-underline small border-bottom mb-3" id="findingsSubTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(showBulk ? "" : "active")" id="findings-list-tab"
                                data-bs-toggle="pill" data-bs-target="#findings-list" type="button" role="tab"
                                aria-controls="findings-list" aria-selected="@(showBulk ? "false" : "true")">
                            <i class="bi bi-list-ul"></i> Potential findings
                            <span class="badge bg-danger ms-1">@Model.PotentialFindingsTotalCount</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(showBulk ? "active" : "")" id="findings-bulk-tab"
                                data-bs-toggle="pill" data-bs-target="#findings-bulk" type="button" role="tab"
                                aria-controls="findings-bulk" aria-selected="@(showBulk ? "true" : "false")">
                            <i class="bi bi-ui-checks"></i> Bulk review
                            <span class="badge @(Model.UnreviewedFindingsCount > 0 ? "bg-warning text-dark" : "bg-success") ms-1" id="bulkUnreviewedBadge"
                                  title="Unreviewed findings">@Model.UnreviewedFindingsCount</span>
                        </button>
                    </li>
                </ul>
            }

            <div class="tab-content">
                <div class="tab-pane fade @(showBulk ? "" : "show active")" id="findings-list" role="tabpanel" aria-labelledby="findings-list-tab">
                <form method="get" asp-page="./Details" class="row g-2 align-items-center mb-3">
                    <input type="hidden" name="id" value="@Model.Scan.Id" />
                    <input type="hidden" name="ActiveTab" value="potential-findings" />
                    <input type="hidden" name="ScanResultsPage" value="@Model.ScanResultsPage" />
                    <input type="hidden" name="ScanResultsSearchTerm" value="@Model.ScanResultsSearchTerm" />
                    <input type="hidden" name="AuditTrailPage" value="@Model.AuditTrailPage" />
                    <input type="hidden" name="AuditTrailSearchTerm" value="@Model.AuditTrailSearchTerm" />
                    <div class="col-sm-4 col-lg-3">
                        <input type="text" name="PotentialFindingsSearchTerm" value="@Model.PotentialFindingsSearchTerm" class="form-control"
                               placeholder="Search potential findings..." />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.PotentialFindingsSearchTerm))
                    {
                        <div class="col-auto">
                            <a asp-page="./Details" asp-route-id="@Model.Scan.Id" asp-route-ActiveTab="potential-findings"
                               asp-route-ScanResultsPage="@Model.ScanResultsPage"
                               asp-route-ScanResultsSearchTerm="@Model.ScanResultsSearchTerm"
                               asp-route-AuditTrailPage="@Model.AuditTrailPage"
                               asp-route-AuditTrailSearchTerm="@Model.AuditTrailSearchTerm"
                               class="btn btn-outline-secondary">Clear</a>
                        </div>
                    }
                </form>

                    @if (canBulkReview && Model.UnreviewedFindingsCount > DetailsModel.ResultsPageSize)
                    {
                        <div class="alert alert-light border d-flex flex-wrap align-items-center justify-content-between gap-2 py-2">
                            <span class="small">
                                <i class="bi bi-lightbulb"></i>
                                @Model.UnreviewedFindingsCount.ToString("N0") findings are still unreviewed. Groups that need the same decision can be reviewed together.
                            </span>
                            <button type="button" class="btn btn-sm btn-outline-primary" id="goToBulkReview">
                                <i class="bi bi-ui-checks"></i> Open Bulk review
                            </button>
                        </div>
                    }

                @if (Model.PotentialFindings != null && Model.PotentialFindings.Any())
                {
                    <div class="table-responsive">
                    <table class="table table-bordered table-hover table-striped sortable mt-2">
                        <thead class="table-primary">
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.PotentialFindings[0].UniqueIdentifier)</th>
                                <th>@Html.DisplayNameFor(model => model.PotentialFindings[0].Timestamp)</th>
                                <th>@Html.DisplayNameFor(model => model.PotentialFindings[0].UserID)</th>
                                <th>@Html.DisplayNameFor(model => model.PotentialFindings[0].ObjectType)</th>
                                <th>@Html.DisplayNameFor(model => model.PotentialFindings[0].Object)</th>
                                <th>@Html.DisplayNameFor(model => model.PotentialFindings[0].Field)</th>
                                <th>@Html.DisplayNameFor(model => model.PotentialFindings[0].Operation)</th>
                                <th>@Html.DisplayNameFor(model => model.PotentialFindings[0].OldValue)</th>
                                <th>@Html.DisplayNameFor(model => model.PotentialFindings[0].NewValue)</th>
                                <th>@Html.DisplayNameFor(model => model.PotentialFindings[0].Reason)</th>
                                <th>@Html.DisplayNameFor(model => model.PotentialFindings[0].Source)</th>
                                <th>@Html.DisplayNameFor(model => model.PotentialFindings[0].Finding)</th>
                                <th class="no-sort">@Html.DisplayNameFor(model => model.PotentialFindings[0].ReviewStatus)</th>
                                @if (!Model.Scan.ScanClosed)
                                {
                                    <th class="no-sort"></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
    @foreach (var item in Model.PotentialFindings) { await RenderScanResultRowAsync(item); }
                        </tbody>
                    </table>
                    </div>

                    @if (Model.PotentialFindingsTotalPages > 1)
                    {
                        <nav aria-label="Potential findings pages">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(Model.PotentialFindingsPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" asp-page="./Details" asp-route-id="@Model.Scan.Id"
                                       asp-route-PotentialFindingsPage="@(Model.PotentialFindingsPage - 1)" asp-route-PotentialFindingsSearchTerm="@Model.PotentialFindingsSearchTerm"
                                       asp-route-ScanResultsPage="@Model.ScanResultsPage" asp-route-ScanResultsSearchTerm="@Model.ScanResultsSearchTerm"
                                       asp-route-AuditTrailPage="@Model.AuditTrailPage" asp-route-AuditTrailSearchTerm="@Model.AuditTrailSearchTerm"
                                       asp-route-ActiveTab="potential-findings"
                                       aria-label="Previous" tabindex="@(Model.PotentialFindingsPage <= 1 ? "-1" : null)">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                                @foreach (var p in Model.PotentialFindingsPageNumbers)
                                {
                                    if (p is null)
                                    {
                                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                    }
                                    else
                                    {
                                        <li class="page-item @(p == Model.PotentialFindingsPage ? "active" : "")">
                                            <a class="page-link" asp-page="./Details" asp-route-id="@Model.Scan.Id"
                                               asp-route-PotentialFindingsPage="@p" asp-route-PotentialFindingsSearchTerm="@Model.PotentialFindingsSearchTerm"
                                               asp-route-ScanResultsPage="@Model.ScanResultsPage" asp-route-ScanResultsSearchTerm="@Model.ScanResultsSearchTerm"
                                               asp-route-AuditTrailPage="@Model.AuditTrailPage" asp-route-AuditTrailSearchTerm="@Model.AuditTrailSearchTerm"
                                               asp-route-ActiveTab="potential-findings">@p</a>
                                        </li>
                                    }
                                }
                                <li class="page-item @(Model.PotentialFindingsPage >= Model.PotentialFindingsTotalPages ? "disabled" : "")">
                                    <a class="page-link" asp-page="./Details" asp-route-id="@Model.Scan.Id"
                                       asp-route-PotentialFindingsPage="@(Model.PotentialFindingsPage + 1)" asp-route-PotentialFindingsSearchTerm="@Model.PotentialFindingsSearchTerm"
                                       asp-route-ScanResultsPage="@Model.ScanResultsPage" asp-route-ScanResultsSearchTerm="@Model.ScanResultsSearchTerm"
                                       asp-route-AuditTrailPage="@Model.AuditTrailPage" asp-route-AuditTrailSearchTerm="@Model.AuditTrailSearchTerm"
                                       asp-route-ActiveTab="potential-findings"
                                       aria-label="Next" tabindex="@(Model.PotentialFindingsPage >= Model.PotentialFindingsTotalPages ? "-1" : null)">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                        <p class="text-center text-muted small">
                            Page @Model.PotentialFindingsPage of @Model.PotentialFindingsTotalPages
                            (@Model.PotentialFindingsTotalCount total finding@(Model.PotentialFindingsTotalCount == 1 ? "" : "s")@(string.IsNullOrWhiteSpace(Model.PotentialFindingsSearchTerm) ? "" : $" matching \"{Model.PotentialFindingsSearchTerm}\"")).
                        </p>
                    }
                }
                else
                {
                    <p class="text-muted mt-2">
                        @(string.IsNullOrWhiteSpace(Model.PotentialFindingsSearchTerm) ? "No findings on this scan." : $"No findings match \"{Model.PotentialFindingsSearchTerm}\".")
                    </p>
                }
                </div>

                @if (canBulkReview)
                {
                    <div class="tab-pane fade @(showBulk ? "show active" : "")" id="findings-bulk" role="tabpanel" aria-labelledby="findings-bulk-tab">
                        <p class="text-muted small mb-3">
                            Review a whole group of findings with one decision and comment. Only findings with no review yet are changed;
                            each one is still recorded individually in the audit trail.
                        </p>

                        <div class="mb-3">
                        @* By rule: summary loaded by script when this sub-tab is shown (OnGetBulkSummaryAsync). *@
                        <div class="card" id="bulkReviewCard"
                             data-summary-url="@Url.Page("./Details", "BulkSummary", new { id = Model.Scan.Id })"
                             data-preview-url="@Url.Page("./Details", "BulkPreview", new { id = Model.Scan.Id })">
                            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <span><i class="bi bi-diagram-3"></i> <strong>By rule</strong></span>
                                <span class="text-muted small" id="bulkSummaryTotal"></span>
                            </div>
                            <div class="card-body p-0" id="bulkSummaryBody">
                                <p class="text-muted small m-3">Loading rule summary&hellip;</p>
                            </div>
                        </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- AI analysis tab -->
        <div class="tab-pane fade @(Model.ActiveTab == "ai-analysis" ? "show active" : "")" id="ai-analysis"
             role="tabpanel" aria-labelledby="ai-analysis-tab"
             data-ai-poll-url="@Url.Page("./Details", "AiAnalysis", new { id = Model.Scan.Id })">
            <div id="ai-analysis-content">
                @if (Model.ScanResultsAI != null && Model.ScanResultsAI.Any())
                {
<div class="table-responsive">
                    <table class="table table-bordered table-hover table-striped mt-2">
                        <thead class="table-success">
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.ScanResultsAI[0].Insight)</th>
                                <th>@Html.DisplayNameFor(model => model.ScanResultsAI[0].Recommendation)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ScanResultsAI)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.Insight)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Recommendation)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
</div>
                }
                else if (Model.AiAnalysisMayBePending)
                {
                    <div id="ai-analysis-pending" class="text-center text-muted mt-4 mb-4">
                        <div class="spinner-border text-primary mb-3" role="status" style="width:2.5rem;height:2.5rem;">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mb-1"><strong>Give us a few seconds&hellip;</strong></p>
                        <p class="mb-0">
                            We're putting together an AI-assisted GxP review of this scan in the
                            background. This tab will update on its own as soon as it's ready --
                            no need to refresh the page.
                        </p>
                    </div>
                }
                else if (!Model.Settings.AiAnalysisEnabled)
                {
                    <p class="text-muted mt-2">
                        AI analysis is currently disabled for this installation
                        @if (User.IsInRole("Admin"))
                        {
                            <text>(see <a asp-page="/AdminPanel/Settings/Index" asp-route-ActiveTab="ai">AI
                            Analysis settings</a>)</text>
                        }
                        . Manually uploaded scans no longer get a background AI analysis step
                        until it's re-enabled.
                    </p>
                }
                else
                {
                    <p class="text-muted mt-2">
                        No AI analysis is available for this scan. Scans ingested through the
                        Integration Hub (FTP or API) don't get an AI analysis step at all; for a
                        manually uploaded scan, this can also mean the background AI job failed
                        or the OpenAI key isn't configured -- check the WebApp logs if that's
                        unexpected (see NFR-014, ADR-0006).
                    </p>
                }
            </div>
        </div>

        <!-- Reviewed & signed tab -->
        <div class="tab-pane fade @(Model.ActiveTab == "signatures" ? "show active" : "")" id="signatures"
             role="tabpanel" aria-labelledby="signatures-tab">
            @if (Model.ScanSignatures.Any())
            {
<div class="table-responsive">
                <table class="table table-bordered table-hover table-striped mt-2">
                    <thead class="table-dark">
                        <tr>
                            <th>User</th>
                            <th>Role</th>
                            <th>Reason</th>
                            <th>Signed at</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sig in Model.ScanSignatures)
                        {
                            <tr>
                                <td>@sig.UserName</td>
                                <td>@sig.Role</td>
                                <td>@sig.Reason</td>
                                <td><utc-datetime value="sig.Timestamp" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
</div>
            }
            else
            {
                <p class="text-muted mt-2">This scan has not been signed yet.</p>
            }
        </div>

        <!-- Audit trail tab: the app's own change log (dbo.AuditTrail), filtered to this scan's
             ScanID -- see DetailsModel.LoadAuditTrailAsync and ATR 0.26's migration script
             remarks. Only entries logged after that column existed carry a ScanID, so a scan
             reviewed/signed before this feature shipped won't show its older history here. -->
        <div class="tab-pane fade @(Model.ActiveTab == "audit-trail" ? "show active" : "")" id="audit-trail"
             role="tabpanel" aria-labelledby="audit-trail-tab">

            <form method="get" asp-page="./Details" class="row g-2 align-items-center mb-3">
                <input type="hidden" name="id" value="@Model.Scan.Id" />
                <input type="hidden" name="ActiveTab" value="audit-trail" />
                <input type="hidden" name="ScanResultsPage" value="@Model.ScanResultsPage" />
                <input type="hidden" name="ScanResultsSearchTerm" value="@Model.ScanResultsSearchTerm" />
                <input type="hidden" name="PotentialFindingsPage" value="@Model.PotentialFindingsPage" />
                <input type="hidden" name="PotentialFindingsSearchTerm" value="@Model.PotentialFindingsSearchTerm" />
                <div class="col-sm-4 col-lg-3">
                    <input type="text" name="AuditTrailSearchTerm" value="@Model.AuditTrailSearchTerm" class="form-control"
                           placeholder="Search by user, operation, field, value, or reason..." />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.AuditTrailSearchTerm))
                {
                    <div class="col-auto">
                        <a asp-page="./Details" asp-route-id="@Model.Scan.Id" asp-route-ActiveTab="audit-trail"
                           asp-route-ScanResultsPage="@Model.ScanResultsPage"
                           asp-route-ScanResultsSearchTerm="@Model.ScanResultsSearchTerm"
                           asp-route-PotentialFindingsPage="@Model.PotentialFindingsPage"
                           asp-route-PotentialFindingsSearchTerm="@Model.PotentialFindingsSearchTerm"
                           class="btn btn-outline-secondary">Clear</a>
                    </div>
                }
            </form>

            @if (Model.AuditTrailEntries.Any())
            {
                <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped sortable mt-2">
                    <thead class="table-primary">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.AuditTrailEntries[0].Timestamp)</th>
                            <th>@Html.DisplayNameFor(model => model.AuditTrailEntries[0].UserID)</th>
                            <th>@Html.DisplayNameFor(model => model.AuditTrailEntries[0].Operation)</th>
                            <th>@Html.DisplayNameFor(model => model.AuditTrailEntries[0].Field)</th>
                            <th>@Html.DisplayNameFor(model => model.AuditTrailEntries[0].OldValue)</th>
                            <th>@Html.DisplayNameFor(model => model.AuditTrailEntries[0].NewValue)</th>
                            <th>@Html.DisplayNameFor(model => model.AuditTrailEntries[0].Reason)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.AuditTrailEntries)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.Timestamp)</td>
                                <td>@Html.DisplayFor(modelItem => item.UserID)</td>
                                <td>@Html.DisplayFor(modelItem => item.Operation)</td>
                                <td>@Html.DisplayFor(modelItem => item.Field)</td>
                                <td>@Html.DisplayFor(modelItem => item.OldValue)</td>
                                <td>@Html.DisplayFor(modelItem => item.NewValue)</td>
                                <td>@Html.DisplayFor(modelItem => item.Reason)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>

                @if (Model.AuditTrailTotalPages > 1)
                {
                    <nav aria-label="Audit trail pages">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.AuditTrailPage <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-page="./Details" asp-route-id="@Model.Scan.Id"
                                   asp-route-AuditTrailPage="@(Model.AuditTrailPage - 1)" asp-route-AuditTrailSearchTerm="@Model.AuditTrailSearchTerm"
                                   asp-route-ScanResultsPage="@Model.ScanResultsPage" asp-route-ScanResultsSearchTerm="@Model.ScanResultsSearchTerm"
                                   asp-route-PotentialFindingsPage="@Model.PotentialFindingsPage" asp-route-PotentialFindingsSearchTerm="@Model.PotentialFindingsSearchTerm"
                                   asp-route-ActiveTab="audit-trail"
                                   aria-label="Previous" tabindex="@(Model.AuditTrailPage <= 1 ? "-1" : null)">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            @foreach (var p in Model.AuditTrailPageNumbers)
                            {
                                if (p is null)
                                {
                                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                }
                                else
                                {
                                    <li class="page-item @(p == Model.AuditTrailPage ? "active" : "")">
                                        <a class="page-link" asp-page="./Details" asp-route-id="@Model.Scan.Id"
                                           asp-route-AuditTrailPage="@p" asp-route-AuditTrailSearchTerm="@Model.AuditTrailSearchTerm"
                                           asp-route-ScanResultsPage="@Model.ScanResultsPage" asp-route-ScanResultsSearchTerm="@Model.ScanResultsSearchTerm"
                                           asp-route-PotentialFindingsPage="@Model.PotentialFindingsPage" asp-route-PotentialFindingsSearchTerm="@Model.PotentialFindingsSearchTerm"
                                           asp-route-ActiveTab="audit-trail">@p</a>
                                    </li>
                                }
                            }
                            <li class="page-item @(Model.AuditTrailPage >= Model.AuditTrailTotalPages ? "disabled" : "")">
                                <a class="page-link" asp-page="./Details" asp-route-id="@Model.Scan.Id"
                                   asp-route-AuditTrailPage="@(Model.AuditTrailPage + 1)" asp-route-AuditTrailSearchTerm="@Model.AuditTrailSearchTerm"
                                   asp-route-ScanResultsPage="@Model.ScanResultsPage" asp-route-ScanResultsSearchTerm="@Model.ScanResultsSearchTerm"
                                   asp-route-PotentialFindingsPage="@Model.PotentialFindingsPage" asp-route-PotentialFindingsSearchTerm="@Model.PotentialFindingsSearchTerm"
                                   asp-route-ActiveTab="audit-trail"
                                   aria-label="Next" tabindex="@(Model.AuditTrailPage >= Model.AuditTrailTotalPages ? "-1" : null)">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                    <p class="text-center text-muted small">
                        Page @Model.AuditTrailPage of @Model.AuditTrailTotalPages
                        (@Model.AuditTrailTotalCount total entr@(Model.AuditTrailTotalCount == 1 ? "y" : "ies")@(string.IsNullOrWhiteSpace(Model.AuditTrailSearchTerm) ? "" : $" matching \"{Model.AuditTrailSearchTerm}\"")).
                    </p>
                }
            }
            else
            {
                <p class="text-muted mt-2">
                    @(string.IsNullOrWhiteSpace(Model.AuditTrailSearchTerm) ? "No audit trail entries found for this scan." : $"No entries match \"{Model.AuditTrailSearchTerm}\".")
                </p>
            }
        </div>

    </div>
</div>

<!-- Review modal -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Review">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReviewScanResultId" id="modalScanResultId" />
                <input type="hidden" asp-for="ScanResultsPage" />
                <input type="hidden" asp-for="ScanResultsSearchTerm" />
                <input type="hidden" asp-for="PotentialFindingsPage" />
                <input type="hidden" asp-for="PotentialFindingsSearchTerm" />
                <input type="hidden" asp-for="AuditTrailPage" />
                <input type="hidden" asp-for="AuditTrailSearchTerm" />
                <input type="hidden" asp-for="ActiveTab" id="reviewModalActiveTab" />
                <div class="modal-header">
                    <h5 class="modal-title" id="reviewModalLabel">Review finding</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Finding</label>
                        <p id="modalFindingText" class="text-danger fst-italic"></p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Review decision</label>
                        <div class="d-flex flex-column gap-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio"
                                       asp-for="ReviewStatus"
                                       id="statusFalsePositive"
                                       value="@((int)FindingReviewStatus.FalsePositive)" />
                                <label class="form-check-label" for="statusFalsePositive">
                                    <span class="badge bg-success">✔ Reviewed / False positive</span>
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio"
                                       asp-for="ReviewStatus"
                                       id="statusInvestigation"
                                       value="@((int)FindingReviewStatus.InvestigationRequired)" />
                                <label class="form-check-label" for="statusInvestigation">
                                    <span class="badge bg-warning text-dark">⚠ Investigation required</span>
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio"
                                       asp-for="ReviewStatus"
                                       id="statusDeviation"
                                       value="@((int)FindingReviewStatus.Deviation)" />
                                <label class="form-check-label" for="statusDeviation">
                                    <span class="badge bg-danger">❌ Deviation</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ReviewComment" class="form-label fw-bold"></label>
                        <textarea asp-for="ReviewComment" class="form-control" rows="3"
                                  placeholder="Optional comment..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save review</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Bulk review modal. The selection (rule or search) is set by the button that opened it; the
   script asks OnGetBulkPreviewAsync how many findings it covers and the reviewer confirms that
   number, which is posted back as BulkExpectedCount (the POST refuses if it has changed). *@
@if (!Model.Scan.ScanClosed)
{
<div class="modal fade" id="bulkReviewModal" tabindex="-1" aria-labelledby="bulkReviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="BulkReview" asp-route-id="@Model.Scan.Id" id="bulkReviewForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="BulkScope" id="bulkScope" />
                <input type="hidden" name="BulkRuleCode" id="bulkRuleCode" />
                <input type="hidden" name="BulkSearchTerm" id="bulkSearchTerm" />
                <input type="hidden" name="BulkExpectedCount" id="bulkExpectedCount" value="0" />
                <input type="hidden" name="ScanResultsPage" value="@Model.ScanResultsPage" />
                <input type="hidden" name="ScanResultsSearchTerm" value="@Model.ScanResultsSearchTerm" />
                <input type="hidden" name="PotentialFindingsPage" value="@Model.PotentialFindingsPage" />
                <input type="hidden" name="PotentialFindingsSearchTerm" value="@Model.PotentialFindingsSearchTerm" />
                <input type="hidden" name="AuditTrailPage" value="@Model.AuditTrailPage" />
                <input type="hidden" name="AuditTrailSearchTerm" value="@Model.AuditTrailSearchTerm" />
                <div class="modal-header">
                    <h5 class="modal-title" id="bulkReviewModalLabel"><i class="bi bi-ui-checks"></i> Bulk review</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Selection</label>
                        <p id="bulkSelectionLabel" class="mb-1"></p>
                        <div class="form-check" id="bulkSoleWrapper">
                            <input class="form-check-input" type="checkbox" name="BulkOnlySoleFinding" value="true" id="bulkOnlySole" checked />
                            <input type="hidden" name="BulkOnlySoleFinding" value="false" />
                            <label class="form-check-label" for="bulkOnlySole">
                                Only rows where this rule is the only finding
                                <span class="text-muted small d-block">Rows that also have other findings are left for individual review, so a decision on this rule doesn't silently cover them.</span>
                            </label>
                        </div>
                    </div>
                    <div class="alert alert-secondary py-2" id="bulkPreview" role="status">Counting matching findings&hellip;</div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Review decision</label>
                        <div class="d-flex flex-column gap-2">
                            <div class="form-check">
                                <input class="form-check-input bulk-status" type="radio" name="BulkReviewStatus" id="bulkStatusFalsePositive"
                                       value="@((int)FindingReviewStatus.FalsePositive)" />
                                <label class="form-check-label" for="bulkStatusFalsePositive">
                                    <span class="badge bg-success">✔ Reviewed / False positive</span>
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input bulk-status" type="radio" name="BulkReviewStatus" id="bulkStatusInvestigation"
                                       value="@((int)FindingReviewStatus.InvestigationRequired)" />
                                <label class="form-check-label" for="bulkStatusInvestigation">
                                    <span class="badge bg-warning text-dark">⚠ Investigation required</span>
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input bulk-status" type="radio" name="BulkReviewStatus" id="bulkStatusDeviation"
                                       value="@((int)FindingReviewStatus.Deviation)" />
                                <label class="form-check-label" for="bulkStatusDeviation">
                                    <span class="badge bg-danger">❌ Deviation</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="bulkComment" class="form-label fw-bold">Review comment <span class="text-danger">*</span></label>
                        <textarea name="BulkReviewComment" id="bulkComment" class="form-control" rows="3" required
                                  placeholder="Required: why this decision applies to every finding in the selection..."></textarea>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="bulkConfirm" />
                        <label class="form-check-label" for="bulkConfirm" id="bulkConfirmLabel">
                            I have checked the findings in this selection, and the decision and comment apply to every one of them.
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="bulkSubmit" disabled>Apply to findings</button>
                </div>
            </form>
        </div>
    </div>
</div>
}

<!-- Assign system modal -->
<div class="modal fade" id="assignSystemModal" tabindex="-1" aria-labelledby="assignSystemModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AssignSystem" asp-route-id="@Model.Scan.Id">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ScanResultsPage" />
                <input type="hidden" asp-for="ScanResultsSearchTerm" />
                <input type="hidden" asp-for="PotentialFindingsPage" />
                <input type="hidden" asp-for="PotentialFindingsSearchTerm" />
                <input type="hidden" asp-for="AuditTrailPage" />
                <input type="hidden" asp-for="AuditTrailSearchTerm" />
                <input type="hidden" asp-for="ActiveTab" id="assignSystemModalActiveTab" />
                <div class="modal-header">
                    <h5 class="modal-title" id="assignSystemModalLabel">Assign system to scan</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (Model.Systems.Any())
                    {
                        <div class="mb-3">
                            <label asp-for="AssignSystemId" class="form-label fw-bold">Select system</label>
                            <select asp-for="AssignSystemId" class="form-select">
                                <option value="0" disabled selected>-- Select a system --</option>
                                @foreach (var sys in Model.Systems)
                                {
                                    <option value="@sys.Id">@sys.SystemPrefixID – @sys.SystemName</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No systems available. Please create a system first.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
