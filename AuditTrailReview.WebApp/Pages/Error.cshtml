@page
@model ErrorModel
@{
    ViewData["Title"] = Model.Heading;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body text-center p-5">
                <i class="bi @Model.IconClass display-3 text-secondary" aria-hidden="true"></i>
                <h1 class="h3 mt-3">@Model.Heading</h1>
                <p class="text-muted">@Model.Message</p>

                @if (Model.ShowRequestId)
                {
                    <p class="small text-muted">
                        Reference: <code>@Model.RequestId</code>
                    </p>
                }

                <div class="d-flex gap-2 justify-content-center mt-4">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-page="/Dashboard/Index" class="btn btn-primary">
                            <i class="bi bi-house" aria-hidden="true"></i> Back to Dashboard
                        </a>
                    }
                    else
                    {
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary">
                            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Go to sign-in
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
