                        <tr>
                            <th>@Html.DisplayNameFor(model => model.AuditTrailMcpEntries[0].Timestamp)</th>
                            <th>@Html.DisplayNameFor(model => model.AuditTrailMcpEntries[0].UserID)</th>
                            <th>@Html.DisplayNameFor(model => model.AuditTrailMcpEntries[0].Operation)</th>
                            <th>@Html.DisplayNameFor(model => model.AuditTrailMcpEntries[0].Field)</th>
                            <th>@Html.DisplayNameFor(model => model.AuditTrailMcpEntries[0].OldValue)</th>
                            <th>@Html.DisplayNameFor(model => model.AuditTrailMcpEntries[0].NewValue)</th>
                            <th>@Html.DisplayNameFor(model => model.AuditTrailMcpEntries[0].Reason)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.AuditTrailMcpEntries)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.Timestamp)</td>
                                <td>@Html.DisplayFor(modelItem => item.UserID)</td>
                                <td>@Html.DisplayFor(modelItem => item.Operation)</td>
                                <td>@Html.DisplayFor(modelItem => item.Field)</td>
                                <td>@Html.DisplayFor(modelItem => item.OldValue)</td>
                                <td>@Html.DisplayFor(modelItem => item.NewValue)</td>
                                <td>@Html.DisplayFor(modelItem => item.Reason)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>

                @if (Model.AuditTrailMcpTotalPages > 1)
                {
                    <nav aria-label="MCP audit trail pages">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.AuditTrailMcpPage <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-page="./Index"
                                   asp-route-AuditTrailMcpPage="@(Model.AuditTrailMcpPage - 1)" asp-route-AuditTrailMcpSearchTerm="@Model.AuditTrailMcpSearchTerm"
                                   asp-route-AuditTrailSecurityPage="@Model.AuditTrailSecurityPage" asp-route-AuditTrailSecuritySearchTerm="@Model.AuditTrailSecuritySearchTerm"
                                   asp-route-AuditTrailGeneralPage="@Model.AuditTrailGeneralPage" asp-route-AuditTrailGeneralSearchTerm="@Model.AuditTrailGeneralSearchTerm"
                                   asp-route-AuditTrailEmailPage="@Model.AuditTrailEmailPage" asp-route-AuditTrailEmailSearchTerm="@Model.AuditTrailEmailSearchTerm"
                                   asp-route-AuditTrailAiPage="@Model.AuditTrailAiPage" asp-route-AuditTrailAiSearchTerm="@Model.AuditTrailAiSearchTerm"
                                   asp-route-AuditTrailApiPage="@Model.AuditTrailApiPage" asp-route-AuditTrailApiSearchTerm="@Model.AuditTrailApiSearchTerm"
                                   asp-route-ActiveTab="audit-trail" asp-route-AuditTrailSubTab="mcp"
                                   aria-label="Previous" tabindex="@(Model.AuditTrailMcpPage <= 1 ? "-1" : null)">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            @foreach (var p in Model.AuditTrailMcpPageNumbers)
                            {
                                if (p is null)
                                {
                                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                }
                                else
                                {
                                    <li class="page-item @(p == Model.AuditTrailMcpPage ? "active" : "")">
                                        <a class="page-link" asp-page="./Index"
                                           asp-route-AuditTrailMcpPage="@p" asp-route-AuditTrailMcpSearchTerm="@Model.AuditTrailMcpSearchTerm"
                                           asp-route-AuditTrailSecurityPage="@Model.AuditTrailSecurityPage" asp-route-AuditTrailSecuritySearchTerm="@Model.AuditTrailSecuritySearchTerm"
                                           asp-route-AuditTrailGeneralPage="@Model.AuditTrailGeneralPage" asp-route-AuditTrailGeneralSearchTerm="@Model.AuditTrailGeneralSearchTerm"
                                           asp-route-AuditTrailEmailPage="@Model.AuditTrailEmailPage" asp-route-AuditTrailEmailSearchTerm="@Model.AuditTrailEmailSearchTerm"
                                           asp-route-AuditTrailAiPage="@Model.AuditTrailAiPage" asp-route-AuditTrailAiSearchTerm="@Model.AuditTrailAiSearchTerm"
                                           asp-route-AuditTrailApiPage="@Model.AuditTrailApiPage" asp-route-AuditTrailApiSearchTerm="@Model.AuditTrailApiSearchTerm"
                                           asp-route-ActiveTab="audit-trail" asp-route-AuditTrailSubTab="mcp">@p</a>
                                    </li>
                                }
                            }
                            <li class="page-item @(Model.AuditTrailMcpPage >= Model.AuditTrailMcpTotalPages ? "disabled" : "")">
                                <a class="page-link" asp-page="./Index"
                                   asp-route-AuditTrailMcpPage="@(Model.AuditTrailMcpPage + 1)" asp-route-AuditTrailMcpSearchTerm="@Model.AuditTrailMcpSearchTerm"
                                   asp-route-AuditTrailSecurityPage="@Model.AuditTrailSecurityPage" asp-route-AuditTrailSecuritySearchTerm="@Model.AuditTrailSecuritySearchTerm"
                                   asp-route-AuditTrailGeneralPage="@Model.AuditTrailGeneralPage" asp-route-AuditTrailGeneralSearchTerm="@Model.AuditTrailGeneralSearchTerm"
                                   asp-route-AuditTrailEmailPage="@Model.AuditTrailEmailPage" asp-route-AuditTrailEmailSearchTerm="@Model.AuditTrailEmailSearchTerm"
                                   asp-route-AuditTrailAiPage="@Model.AuditTrailAiPage" asp-route-AuditTrailAiSearchTerm="@Model.AuditTrailAiSearchTerm"
                                   asp-route-AuditTrailApiPage="@Model.AuditTrailApiPage" asp-route-AuditTrailApiSearchTerm="@Model.AuditTrailApiSearchTerm"
                                   asp-route-ActiveTab="audit-trail" asp-route-AuditTrailSubTab="mcp"
                                   aria-label="Next" tabindex="@(Model.AuditTrailMcpPage >= Model.AuditTrailMcpTotalPages ? "-1" : null)">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                    <p class="text-center text-muted small">
                        Page @Model.AuditTrailMcpPage of @Model.AuditTrailMcpTotalPages
                        (@Model.AuditTrailMcpTotalCount total entr@(Model.AuditTrailMcpTotalCount == 1 ? "y" : "ies")@(string.IsNullOrWhiteSpace(Model.AuditTrailMcpSearchTerm) ? "" : $" matching \"{Model.AuditTrailMcpSearchTerm}\"")).
                    </p>
                }
            }
            else
            {
                <p class="text-muted mt-2">
                    @(string.IsNullOrWhiteSpace(Model.AuditTrailMcpSearchTerm) ? "No audit trail entries found for MCP keys." : $"No entries match \"{Model.AuditTrailMcpSearchTerm}\".")
                </p>
            }
        </div>

    </div>
</div>

</div>

<!-- AI Analysis tab's "Test connection" result -- populated by fetch, not a submitted form. -->
<div class="modal fade" id="aiTestConnectionModal" tabindex="-1" aria-labelledby="aiTestConnectionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="aiTestConnectionModalLabel">Test connection</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="aiTestConnectionResult"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Email tab's "Test connection" result -- same fetch-based, no-DB-write pattern as the AI tab's. -->
<div class="modal fade" id="emailTestConnectionModal" tabindex="-1" aria-labelledby="emailTestConnectionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="emailTestConnectionModalLabel">Test connection</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="emailTestConnectionResult"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Endpoint's placeholder hints at the expected shape for the selected provider --
        // AiSettings.Validate (server-side) is the actual source of truth for what's required;
        // this is display only. Switching to OpenAI also prefills Endpoint with its default
        // host (rather than just showing it as a placeholder) so an admin isn't left to guess
        // the exact value, but only when the field is still empty -- a deliberately-set custom
        // endpoint (e.g. a proxy/gateway) is never overwritten.
        (function () {
            var providerSelect = document.getElementById('aiProviderSelect');
            var endpointInput = document.getElementById('aiEndpointInput');
            if (!providerSelect || !endpointInput) return;

            var openAiDefaultEndpoint = 'https://api.openai.com';

            function toggle() {
                var isOpenAi = providerSelect.value === '0';
                endpointInput.placeholder = isOpenAi
                    ? openAiDefaultEndpoint
                    : 'https://my-resource.openai.azure.com/openai/v1';

                if (isOpenAi && !endpointInput.value) {
                    endpointInput.value = openAiDefaultEndpoint;
                }
            }

            providerSelect.addEventListener('change', toggle);
            toggle();
        })();

        // "Test connection" posts the AI tab's CURRENT (possibly unsaved) field values to
        // OnPostTestAiConnectionAsync via fetch -- nothing is saved, the page doesn't navigate,
        // and the result (success or a readable error from OpenAIService.TestConnectionAsync)
        // is shown in the aiTestConnectionModal above rather than a full-page alert.
        (function () {
            var testButton = document.getElementById('aiTestConnectionBtn');
            var modalElement = document.getElementById('aiTestConnectionModal');
            var resultContainer = document.getElementById('aiTestConnectionResult');
            if (!testButton || !modalElement || !resultContainer) return;

            var form = testButton.closest('form');
            var modal = new bootstrap.Modal(modalElement);

            function renderResult(isSuccess, message) {
                var alertClass = isSuccess ? 'alert-success' : 'alert-danger';
                var icon = isSuccess ? 'bi-check-circle' : 'bi-exclamation-triangle';
                var text = document.createElement('div');
                text.textContent = message || (isSuccess ? 'Connection successful.' : 'The test failed.');
                resultContainer.innerHTML = '<div class="alert ' + alertClass + ' mb-0 d-flex align-items-start gap-2"><i class="bi ' + icon + '"></i><div>' + text.innerHTML + '</div></div>';
            }

            testButton.addEventListener('click', async function () {
                if (!form) return;

                testButton.disabled = true;
                resultContainer.innerHTML = '<div class="d-flex align-items-center gap-2 text-muted"><div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div> Testing connection...</div>';
                modal.show();

                try {
                    var response = await fetch('@Url.Page(null, "TestAiConnection")', {
                        method: 'POST',
                        body: new FormData(form),
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (!response.ok) {
                        renderResult(false, 'The test request itself failed (HTTP ' + response.status + ').');
                        return;
                    }

                    var data = await response.json();
                    renderResult(!!data.success, data.message);
                } catch (err) {
                    renderResult(false, 'Could not reach the server to run the test.');
                } finally {
                    testButton.disabled = false;
                }
            });
        })();

        // Email tab's "Test connection" -- identical pattern to the AI tab's above, posting to
        // OnPostTestEmailConnectionAsync instead, which sends one real test email using this
        // form's current (possibly unsaved) field values.
        (function () {
            var testButton = document.getElementById('emailTestConnectionBtn');
            var modalElement = document.getElementById('emailTestConnectionModal');
            var resultContainer = document.getElementById('emailTestConnectionResult');
            if (!testButton || !modalElement || !resultContainer) return;

            var form = testButton.closest('form');
            var modal = new bootstrap.Modal(modalElement);

            function renderResult(isSuccess, message) {
                var alertClass = isSuccess ? 'alert-success' : 'alert-danger';
                var icon = isSuccess ? 'bi-check-circle' : 'bi-exclamation-triangle';
                var text = document.createElement('div');
                text.textContent = message || (isSuccess ? 'Connection successful.' : 'The test failed.');
                resultContainer.innerHTML = '<div class="alert ' + alertClass + ' mb-0 d-flex align-items-start gap-2"><i class="bi ' + icon + '"></i><div>' + text.innerHTML + '</div></div>';
            }

            testButton.addEventListener('click', async function () {
                if (!form) return;

                testButton.disabled = true;
                resultContainer.innerHTML = '<div class="d-flex align-items-center gap-2 text-muted"><div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div> Sending a test email...</div>';
                modal.show();

                try {
                    var response = await fetch('@Url.Page(null, "TestEmailConnection")', {
                        method: 'POST',
                        body: new FormData(form),
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (!response.ok) {
                        renderResult(false, 'The test request itself failed (HTTP ' + response.status + ').');
                        return;
                    }

                    var data = await response.json();
                    renderResult(!!data.success, data.message);
                } catch (err) {
                    renderResult(false, 'Could not reach the server to run the test.');
                } finally {
                    testButton.disabled = false;
                }
            });
        })();
    </script>
}
