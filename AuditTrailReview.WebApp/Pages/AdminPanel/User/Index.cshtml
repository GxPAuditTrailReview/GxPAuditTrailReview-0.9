@page
@model AuditTrailReview.WebApp.Pages.AdminPanel.User.IndexModel

@{
    ViewData["Title"] = "Users";
}

<partial name="_Breadcrumb" model="@(new[] { new BreadcrumbItem("Admin Panel"), new BreadcrumbItem("Users") })" />

<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<form method="get" asp-page="./Index" class="row g-2 align-items-center mb-3">
    <div class="col-auto">
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-square"></i> &nbsp; Create New
        </a>
    </div>
    <div class="col-auto">
        <a asp-page-handler="Export" class="btn btn-success">
            📥 Export to Excel
        </a>
    </div>
    <div class="col-sm-4 col-lg-3">
        <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control"
               placeholder="Search by username, email, or name..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-search"></i> Search
        </button>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
    {
        <div class="col-auto">
            <a asp-page="./Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    }
</form>

<div class="table-responsive">
<table class="table table-bordered table-hover table-striped sortable">
    <thead class="table-primary">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Users[0].UserName)
            </th>
            <th>Name</th>
            <th>Status</th>
            <th class="no-sort"></th> @*  to not sort the collumn *@
        </tr>
    </thead>
    <tbody>
@if (Model.Users.Count == 0)
{
        <tr>
            <td colspan="4" class="text-center text-muted py-4">
                <i class="bi bi-inbox"></i>
                @(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "No users found." : $"No users match \"{Model.SearchTerm}\".")
            </td>
        </tr>
}
        @foreach (var item in Model.Users)
        {
        <tr>
            <td>
                    @Html.DisplayFor(modelItem => item.UserName)
            </td>
            <td>
                    @($"{item.FirstName} {item.LastName}".Trim())
            </td>
            <td>
                @if (Model.DeactivatedUserIds.Contains(item.Id))
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
                else
                {
                    <span class="badge bg-success">Active</span>
                }
            </td>
            <td>
                    <div class="w-35 btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-warning nx-2"
                           data-bs-toggle="tooltip" title="View details">
                            <i class="bi bi-eye"></i>
                        </a>

                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-primary nx-2"
                           data-bs-toggle="tooltip" title="Edit user">
                            <i class="bi bi-pencil-square"></i>
                        </a>

                        <form method="post" asp-page-handler="SendCredentials" asp-route-id="@item.Id" style="display:inline">
                            <button type="submit" class="btn btn-secondary nx-2" data-bs-toggle="tooltip" title="Reset password by sending email">
                                <i class="bi bi-envelope-fill"></i>
                            </button>
                        </form>

                        @if (Model.UserIdsWithScanActivity.Contains(item.Id))
                        {
                            <span class="d-inline-block" data-bs-toggle="tooltip" title="This user has uploaded scans and cannot be deleted.">
                                <button type="button" class="btn btn-danger nx-2" disabled style="pointer-events: none;">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </span>
                        }
                        else
                        {
                            <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger nx-2"
                               data-bs-toggle="tooltip" title="Delete user">
                                <i class="bi bi-trash-fill"></i>
                            </a>
                        }
                    </div>
            </td>
        </tr>
}
    </tbody>
</table>
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="User pages">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                <a class="page-link" asp-page="./Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-SearchTerm="@Model.SearchTerm"
                   aria-label="Previous" tabindex="@(Model.PageNumber <= 1 ? "-1" : null)">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            @foreach (var p in Model.PageNumbersToDisplay)
            {
                if (p is null)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
                else
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-page="./Index" asp-route-PageNumber="@p" asp-route-SearchTerm="@Model.SearchTerm">@p</a>
                    </li>
                }
            }
            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-page="./Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-SearchTerm="@Model.SearchTerm"
                   aria-label="Next" tabindex="@(Model.PageNumber >= Model.TotalPages ? "-1" : null)">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
    <p class="text-center text-muted small">
        Page @Model.PageNumber of @Model.TotalPages
        (@Model.TotalCount total user@(Model.TotalCount == 1 ? "" : "s")@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "" : $" matching \"{Model.SearchTerm}\"")).
    </p>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var tooltipEls = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            tooltipEls.forEach(function (el) {
                new bootstrap.Tooltip(el);
            });
        });
    </script>
}
