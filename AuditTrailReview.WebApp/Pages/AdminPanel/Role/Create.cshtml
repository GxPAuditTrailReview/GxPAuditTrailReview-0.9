@page
@model AuditTrailReview.WebApp.Pages.AdminPanel.Role.CreateModel

@{
    ViewData["Title"] = "New Role";
}
<partial name="_Breadcrumb" model="@(new[] { new BreadcrumbItem("Admin Panel"), new BreadcrumbItem("Roles", "/AdminPanel/Role/Index"), new BreadcrumbItem("New role") })" />
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-info">
                    <i class="bi bi-back"></i> &nbsp; Back to List
                </a>
            </div>
            <br />

            <div class="form-group">
                <label asp-for="RoleName" class="control-label"></label>
                <input asp-for="RoleName" class="form-control" required />
                <span asp-validation-for="RoleName" class="text-danger"></span>
            </div>

        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
