@page
@model AuditTrailReview.WebApp.Pages.AdminPanel.Role.DeleteModel;
@{
    ViewData["Title"] = $"Delete role {Model.RoleName}";
}


<partial name="_Breadcrumb" model="@(new[] { new BreadcrumbItem("Admin Panel"), new BreadcrumbItem("Roles", "/AdminPanel/Role/Index"), new BreadcrumbItem($"Delete {Model.RoleName}") })" />
<hr>
<h3>Are you sure you want to delete this?</h3>
<hr />

<form method="post">
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-page="./Index" class="btn btn-info">Back to List</a>
</form>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.RoleName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.RoleName) @* // <label>User Name: </label> @Model.User.UserName *@
        </dd>
    </dl>

</div>

