# Copy this file to .env (gitignored, never commit the real one) and fill in real values.
# docker compose automatically reads .env from the project folder (the repository root, because the commands use --project-directory .) and substitutes ${VAR}
# references in docker-compose.postgres.yml.

# Master key for secrets the app stores encrypted in the database -- the OpenAI key saved from
# the AI Analysis tab and the SMTP password saved from the Email tab (both under Admin Panel ->
# Application Settings), AES-256-GCM (AuditTrailReview.Engine.Security.ApiKeyProtector). Must be
# a base64-encoded, random 32-byte value, and identical across every process that reads it
# (webapp and worker in docker-compose.postgres.yml).
#
# Generate one:
#   PowerShell: $b=New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   bash:       openssl rand -base64 32
#
# Leave unset/empty to run the PostgreSQL Docker flavor without the "store the OpenAI key/SMTP
# password in the database" features -- manual upload and rule-based scanning work fine without
# it, and SMTP credentials can still be set via SmtpSettings__* instead.
ENCRYPTION_KEY=
