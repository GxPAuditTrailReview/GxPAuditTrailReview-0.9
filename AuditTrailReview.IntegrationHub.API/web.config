<?xml version="1.0" encoding="utf-8"?>
<!--
  Hand-authored so it survives `dotnet publish`: when a web.config already exists in the
  project, the .NET SDK transforms it in place (filling in/checking processPath, arguments and
  hostingModel below) instead of generating a fresh one, so the <security> block added here is
  preserved across every publish. See "Deploy ASP.NET Core apps to IIS" in the ASP.NET Core docs
  for the transform's exact behavior. Mirrors AuditTrailReview.WebApp/web.config.

  Only takes effect if this API is ever hosted under IIS -- it ships a Dockerfile too (see
  Installation Manual.md), where this file is inert and Kestrel's own request-body limit
  (raised via ScanProcessingController's [RequestSizeLimit]/[RequestFormLimits] instead) is what
  applies.

  maxAllowedContentLength below matches ScanProcessingController's [RequestSizeLimit(OuterCeilingBytes)]
  -- see that file's comment for the tiered-processing design behind this ceiling (uploads over
  50 MB now process in the background -- Tier 2 in-process, Tier 3 via
  AuditTrailReview.IntegrationHub.WorkerService -- instead of being rejected outright). Capped at
  786,432,000 bytes / 750 MiB (down from an earlier 1,000,000,000-byte ceiling that was raised
  specifically to allow testing a real ~714 MB / 5,000,000-record file through Tier 3).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\AuditTrailReview.IntegrationHub.API.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <!-- 786,432,000 bytes: matches ScanProcessingController's [RequestSizeLimit]. -->
          <requestLimits maxAllowedContentLength="786432000" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
