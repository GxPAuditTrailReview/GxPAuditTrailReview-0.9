<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-AuditTrailReview.Connector-52683616-ef77-4f35-98c5-6444c7a92409</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentFTP" Version="55.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Only used when Database:Provider=Postgres (docker-compose.postgres.yml), matching the WebApp's
         own Postgres flavor so the Worker Service can drain ScanUploadJob Tier.Worker rows there. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />

    <!-- Structured, DB-persisted application logging (Path to v1.0.md item 29, Worker Service
         follow-up; DB-only as of the Fortieth follow-up). Writes to the same
         dbo.ApplicationLog table as AuditTrailReview.WebApp (see ATR 0.9's schema addendum for
         the Application column that tells the two components' rows apart). This project is a
         plain Generic Host (Microsoft.NET.Sdk.Worker, Host.CreateApplicationBuilder), not an
         ASP.NET Core app, so it references Serilog.Extensions.Hosting (for the HostApplication-
         Builder-era Services.AddSerilog(...) pattern) plus the individual sinks directly, rather
         than the heavier Serilog.AspNetCore meta-package the WebApp uses. The local rolling
         "Logs/apperror-*.log" file sink and Serilog.Sinks.File package were removed; events
         now go to dbo.ApplicationLog only. Versions below are
         believed current but have NOT been restored/build-verified in this session (no dotnet
         toolchain available here); let NuGet resolve/update to the actual latest compatible
         versions on first restore. -->
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.MSSqlServer" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuditTrailReview.Engine\AuditTrailReview.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Dockerfile" Condition="Exists('Dockerfile')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
