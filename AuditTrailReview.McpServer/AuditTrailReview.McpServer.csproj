<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official MCP C# SDK. ModelContextProtocol.AspNetCore brings in ModelContextProtocol
         itself transitively and adds WithHttpTransport()/MapMcp() for hosting over HTTP (SSE),
         as opposed to the stdio transport used for a locally-launched, per-session server.
         Version believed current but NOT restored/build-verified against a live NuGet feed in
         this session, same caveat as the other components' csproj files; let NuGet resolve to
         the actual latest compatible version on first restore if this one is stale. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />

    <!-- Only used when Database:Provider=Postgres (docker-compose.postgres.yml), matching the
         WebApp/IntegrationHub.WorkerService's own Postgres flavor (see Program.cs). -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only Engine is referenced directly, same as IntegrationHub.WorkerService; it already
         carries AuditTrailReview.Database (ApplicationDbContext, EF Core SqlServer provider) and
         AuditTrailReview.Model transitively, so no separate ProjectReference to either is needed
         here. -->
    <ProjectReference Include="..\AuditTrailReview.Engine\AuditTrailReview.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
